#!/usr/bin/env bash
# ==============================================================================
# Centro de Control RUR — UNIPOLI Durango
# Instalador Autónomo para Linux (Ubuntu 20.04 / 22.04 / 24.04 / Debian / Arch)
# ==============================================================================
set -e

# Colores terminal
CYAN='\033[0;36m'
GOLD='\033[1;33m'
GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'

echo -e "${GOLD}==============================================================================${NC}"
echo -e "${GOLD}  CENTRO DE CONTROL DE OPERACIONES RUR — UNIPOLI DURANGO${NC}"
echo -e "${CYAN}  Instalador Autónomo para Linux // ROS 2 // Fast-DDS // LiveKit${NC}"
echo -e "${GOLD}==============================================================================${NC}"
echo ""

INSTALL_DIR="$HOME/.local/share/centro-de-control"
APPLICATIONS_DIR="$HOME/.local/share/applications"
ICONS_DIR="$HOME/.local/share/icons"

echo -e "${CYAN}[1/5] Preparando directorio de instalación...${NC}"
mkdir -p "$INSTALL_DIR" "$APPLICATIONS_DIR" "$ICONS_DIR"

echo -e "${CYAN}[2/5] Extrayendo archivos del sistema RUR...${NC}"

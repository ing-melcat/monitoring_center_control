pEzbYJxsCjBjzDrx2MBKqZeICaGPcmQqas0d0LH/8unv09+nv09//t9/AcSwxsIA8C8A
EOF_RUR_PAYLOAD

# -----------------------------------------------------------------------------
# Verificar e instalar Node.js si no existe
# -----------------------------------------------------------------------------
echo ""
echo -e "${CYAN}[3/5] Verificando entorno Node.js...${NC}"
if ! command -v node >/dev/null 2>&1; then
  echo -e "${GOLD}[AVISO] Node.js no está instalado en este equipo.${NC}"
  if command -v apt-get >/dev/null 2>&1; then
    read -p "¿Deseas instalar Node.js automáticamente con sudo apt? (s/n): " -n 1 -r
    echo ""
    if [[ $REPLY =~ ^[Ss]$ ]]; then
      sudo apt-get update
      sudo apt-get install -y nodejs npm
    fi
  else
    echo -e "${RED}[ERROR] Por favor instala Node.js (v18+) con tu gestor de paquetes (apt, dnf, pacman).${NC}"
  fi
fi

if command -v node >/dev/null 2>&1; then
  echo -e "${GREEN}[OK] Node.js detectado: $(node -v)${NC}"
else
  echo -e "${GOLD}[AVISO] Recuerda instalar Node.js antes de arrancar la cabina.${NC}"
fi

# -----------------------------------------------------------------------------
# Instalar dependencias npm y permisos
# -----------------------------------------------------------------------------
echo ""
echo -e "${CYAN}[4/5] Instalando dependencias de comunicación...${NC}"
cd "$INSTALL_DIR"
if command -v npm >/dev/null 2>&1; then
  npm install --omit=dev --no-audit --no-fund 2>/dev/null || npm install 2>/dev/null || true
fi

chmod +x "$INSTALL_DIR/"*.sh 2>/dev/null || true
chmod +x "$INSTALL_DIR/scripts/"*.sh 2>/dev/null || true

# Configurar plantilla de entorno .env si falta
if [ ! -f "$INSTALL_DIR/scripts/.env" ] && [ -f "$INSTALL_DIR/scripts/.env.example" ]; then
  cp "$INSTALL_DIR/scripts/.env.example" "$INSTALL_DIR/scripts/.env"
fi

# Copiar icono oficial
if [ -f "$INSTALL_DIR/public/assets/isotipo.png" ]; then
  cp "$INSTALL_DIR/public/assets/isotipo.png" "$ICONS_DIR/rur.png"
fi

# -----------------------------------------------------------------------------
# Crear script lanzador maestro independiente (iniciar.sh)
# -----------------------------------------------------------------------------
cat > "$INSTALL_DIR/iniciar.sh" << 'EOF_LAUNCHER'
#!/usr/bin/env bash
APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$APP_DIR"

# Cargar entorno de ROS 2 si está instalado (Jazzy, Humble, Iron, Rolling)
for ROS_SETUP in /opt/ros/jazzy/setup.bash /opt/ros/humble/setup.bash /opt/ros/iron/setup.bash /opt/ros/rolling/setup.bash; do
  if [ -f "$ROS_SETUP" ]; then
    # shellcheck disable=SC1090
    source "$ROS_SETUP"
    break
  fi
done

export ROS_DOMAIN_ID=42
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
export PYTHONUNBUFFERED=1

# Iniciar servidor si el puerto 3000 no responde
STARTED_BY_LAUNCHER=0
if ! ss -tln 2>/dev/null | grep -q ":3000 " && ! nc -z 127.0.0.1 3000 2>/dev/null; then
  node "$APP_DIR/server.js" >/tmp/rur-control-center.log 2>&1 &
  SERVER_PID=$!
  STARTED_BY_LAUNCHER=1
  for i in $(seq 1 12); do
    if ss -tln 2>/dev/null | grep -q ":3000 " || nc -z 127.0.0.1 3000 2>/dev/null; then
      break
    fi
    sleep 0.5
  done
fi

cleanup() {
  if [ "$STARTED_BY_LAUNCHER" -eq 1 ] && [ -n "${SERVER_PID:-}" ]; then
    kill "$SERVER_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

URL="http://127.0.0.1:3000"

if command -v google-chrome >/dev/null 2>&1; then
  google-chrome --app="$URL" --window-size=1440,900
elif command -v chromium-browser >/dev/null 2>&1; then
  chromium-browser --app="$URL" --window-size=1440,900
elif command -v chromium >/dev/null 2>&1; then
  chromium --app="$URL" --window-size=1440,900
elif command -v microsoft-edge >/dev/null 2>&1; then
  microsoft-edge --app="$URL" --window-size=1440,900
elif command -v brave-browser >/dev/null 2>&1; then
  brave-browser --app="$URL" --window-size=1440,900
else
  xdg-open "$URL"
  if [ -n "${SERVER_PID:-}" ]; then
    wait "$SERVER_PID"
  fi
fi
EOF_LAUNCHER
chmod +x "$INSTALL_DIR/iniciar.sh"

# -----------------------------------------------------------------------------
# Crear lanzador de escritorio .desktop
# -----------------------------------------------------------------------------
echo ""
echo -e "${CYAN}[5/5] Creando accesos directos en el sistema Linux...${NC}"
DESKTOP_ENTRY="[Desktop Entry]
Version=1.0
Type=Application
Name=Centro de Control RUR
Comment=Estación Terrena ROS 2 y Telemetría LiveKit — RUR UNIPOLI Durango
Exec=$INSTALL_DIR/iniciar.sh
Path=$INSTALL_DIR
Icon=$ICONS_DIR/rur.png
Terminal=false
Categories=Development;Science;Robotics;Utility;
StartupNotify=true
"

echo "$DESKTOP_ENTRY" > "$APPLICATIONS_DIR/centro-de-control.desktop"
chmod +x "$APPLICATIONS_DIR/centro-de-control.desktop"

# Copiar a Desktop / Escritorio si existen
for DT_DIR in "$HOME/Desktop" "$HOME/Escritorio"; do
  if [ -d "$DT_DIR" ]; then
    echo "$DESKTOP_ENTRY" > "$DT_DIR/Centro de Control RUR.desktop"
    chmod +x "$DT_DIR/Centro de Control RUR.desktop"
    gio set "$DT_DIR/Centro de Control RUR.desktop" metadata::trusted true 2>/dev/null || true
  fi
done

echo ""
echo -e "${GREEN}==============================================================================${NC}"
echo -e "${GREEN}  ¡INSTALACIÓN COMPLETADA EXITOSAMENTE!${NC}"
echo -e "${GREEN}==============================================================================${NC}"
echo -e "El Centro de Control RUR quedó instalado en: ${GOLD}$INSTALL_DIR${NC}"
echo -e "Se creó el acceso en tu menú de aplicaciones y en tu Escritorio."
echo ""

read -p "¿Deseas iniciar el Centro de Control ahora mismo? (s/n): " -n 1 -r
echo ""
if [[ $REPLY =~ ^[Ss]$ ]]; then
  "$INSTALL_DIR/iniciar.sh" &
fi
exit 0
